# =============================================================================
# autonomous-dashboard — environment variables template
# Copy this file to .env.local and fill in your values.
# Never commit .env.local to version control.
# =============================================================================

# --- Supabase ------------------------------------------------------------------
# Project URL from https://app.supabase.com → Settings → API
SUPABASE_URL=

# Anon / public key from https://app.supabase.com → Settings → API
SUPABASE_ANON_KEY=

# Postgres connection string (used for direct DB access)
# Format: postgresql://postgres:<password>@<host>:<port>/<db>
DATABASE_URL=

# --- OpenRouter ----------------------------------------------------------------
# API key from https://openrouter.ai/keys
OPENROUTER_API_KEY=

# --- Openclaw Gateway ----------------------------------------------------------
# Internal gateway host (default: 127.0.0.1)
OPENCLAW_GATEWAY_HOST=127.0.0.1

# Internal gateway port (default: 18789)
OPENCLAW_GATEWAY_PORT=18789

# Bearer token for the Openclaw gateway
OPENCLAW_GATEWAY_TOKEN=

# --- Server --------------------------------------------------------------------
# Port the Next.js server listens on (default: 3000)
PORT=3000
